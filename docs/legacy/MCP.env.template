# LLM Provider (options: OLLAMA, OPENAI, GOOGLE, ANTHROPIC)
LLM_PROVIDER=OLLAMA

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Google Gemini settings
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-pro

# Anthropic (Claude) settings
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-2


LOG_LEVEL=ERROR

# Database configuration

#For SQLite:
DB_TYPE=sqlite
DB_PATH=database.db

#For PostgreSQL:
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=your_database

#For MySQL:
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database

#For MSSQL:
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_password
DB_NAME=your_database
DB_DRIVER=ODBC Driver 17 for SQL Server


#RAG Vault Directory
RAG_DOCS_DIR=LLM_CI/docs
VAULT_DIR=LLM_CI/vault
# Vault file (each line is treated as a chunk). Can be absolute or relative.
VAULT_FILE=LLM_CI/vault.txt

# Embedding model names (used when Ollama/OpenAI are available)
OLLAMA_EMBED_MODEL=mxbai-embed-large
OPENAI_EMBED_MODEL=text-embedding-3-large

# Note: The GUI/CLI will attempt to compute and cache embeddings at startup
# if `RAG_DOCS_DIR` is set. You can also run compute_and_cache_vault_embeddings()
# manually to refresh the cache after modifying the vault.

# Unified Agent configuration
RAG_COLLECTION_NAME=rag_collection
MAX_REFLECTION_ITERATIONS=3
